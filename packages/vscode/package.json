{
  "name": "tokenlens-vscode",
  "displayName": "TokenLens",
  "description": "Local Copilot credit and token analytics with daily, weekly and monthly charts, budget forecasts, and session cost guidance.",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "publisher": "tokenlens",
  "preview": true,
  "pricing": "Free",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#17191d",
    "theme": "dark"
  },
  "homepage": "https://github.com/Ashutosh-Panda2004/TokensLens#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ashutosh-Panda2004/TokensLens.git",
    "directory": "packages/vscode"
  },
  "bugs": {
    "url": "https://github.com/Ashutosh-Panda2004/TokensLens/issues"
  },
  "keywords": [
    "copilot",
    "credits",
    "tokens",
    "cost",
    "finops",
    "analytics"
  ],
  "engines": {
    "vscode": "^1.90.0",
    "node": ">=20"
  },
  "categories": [
    "Other",
    "Visualization"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "virtualWorkspaces": {
      "supported": false,
      "description": "TokenLens requires a local filesystem and the TokenLens core binary."
    },
    "untrustedWorkspaces": {
      "supported": false,
      "description": "TokenLens starts a configured local binary and reads local VS Code journal metadata."
    }
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tokenlens",
          "title": "TokenLens",
          "icon": "media/activity.svg"
        }
      ]
    },
    "views": {
      "tokenlens": [
        {
          "type": "webview",
          "id": "tokenlens.hud",
          "name": "Spend"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "tokenlens.refresh",
          "when": "view == tokenlens.hud",
          "group": "navigation"
        },
        {
          "command": "tokenlens.openDashboard",
          "when": "view == tokenlens.hud",
          "group": "navigation"
        }
      ]
    },
    "commands": [
      {
        "command": "tokenlens.refresh",
        "title": "Refresh credit figures",
        "category": "TokenLens",
        "icon": "$(refresh)"
      },
      {
        "command": "tokenlens.openDashboard",
        "title": "Open dashboard",
        "category": "TokenLens",
        "icon": "$(dashboard)"
      },
      {
        "command": "tokenlens.showBreakdown",
        "title": "Show spend breakdown",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.showSettings",
        "title": "Show settings in force",
        "category": "TokenLens"
      },
      {
        "command": "tokenlens.newChat",
        "title": "Start a fresh chat",
        "category": "TokenLens"
      }
    ],
    "configuration": {
      "title": "TokenLens",
      "properties": {
        "tokenlens.binaryPath": {
          "type": "string",
          "default": "tokenlens",
          "description": "How to invoke the TokenLens core binary. Leave as 'tokenlens' if it is on PATH."
        },
        "tokenlens.plan": {
          "type": "string",
          "enum": [
            "",
            "pro",
            "pro-plus",
            "max",
            "business",
            "enterprise"
          ],
          "enumDescriptions": [
            "Inherit the plan from TokenLens config, so the CLI, dashboard and this extension agree.",
            "Override: Copilot Pro.",
            "Override: Copilot Pro+.",
            "Override: Copilot Max.",
            "Override: Copilot Business.",
            "Override: Copilot Enterprise."
          ],
          "default": "",
          "markdownDescription": "Overrides the Copilot plan set in `.tokenlens/config.json`. Leave empty to inherit the shared setting — set it in the dashboard under Settings instead, so every surface agrees."
        },
        "tokenlens.refreshSeconds": {
          "type": "number",
          "default": 300,
          "minimum": 30,
          "markdownDescription": "Safety-net poll interval. TokenLens watches the chat journals and refreshes within seconds of a turn finishing, so this rarely needs lowering — each poll starts the core binary, which is not free."
        },
        "tokenlens.statusBar.metric": {
          "type": "string",
          "enum": [
            "auto",
            "remaining",
            "spent",
            "today",
            "session",
            "projected"
          ],
          "enumDescriptions": [
            "Remaining when a limit is set, spend and money when it is not.",
            "Same as auto — remaining where that is meaningful.",
            "Credits and money spent this month.",
            "Credits and money spent in this workspace today.",
            "What the next turn of the longest conversation will cost.",
            "Projected month-end credits and money."
          ],
          "default": "auto",
          "markdownDescription": "Which single figure the status bar shows. The binding constraint differs by plan, so this is configurable rather than assumed."
        },
        "tokenlens.notifications": {
          "type": "boolean",
          "default": true,
          "description": "Warn once at 75%, 90% and 100% of the monthly allowance. Each fires at most once per month."
        },
        "tokenlens.multiRoot": {
          "type": "string",
          "enum": [
            "aggregate",
            "active-editor"
          ],
          "enumDescriptions": [
            "Cover every folder in the workspace — what the window claims to be showing.",
            "Cover only the folder containing the active editor."
          ],
          "default": "aggregate",
          "markdownDescription": "How a multi-root workspace is scoped. Reporting only the first folder, which is what happens without this, understates a multi-root workspace silently."
        },
        "tokenlens.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Show the status-bar item."
        }
      }
    }
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/tsconfig.json",
    "package": "npm run build && vsce package --no-dependencies",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "devDependencies": {
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "@tokenslens/core": "*",
    "vitest": "^5.0.3"
  }
}
