{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // module/moduleResolution are inherited as NodeNext from the base
    // config, not overridden to the classic "CommonJS"/"Node" pair: this
    // package.json has no "type": "module", so NodeNext still resolves
    // and emits extension.ts as CommonJS (what the classic VS Code
    // extension host requires) — without the "Node" moduleResolution
    // value, which is deprecated as of TypeScript 6.0 and removed in 7.0.
    "outDir": "./dist",
    "rootDir": "./src",
    "types": ["node", "vscode"],
    // The classic VS Code extension host requires a CommonJS entry point.
    // verbatimModuleSyntax (inherited from tsconfig.base.json) forbids
    // top-level value `export` in a CommonJS module (TS1287) — it assumes
    // an ESM target. This is the one package in the monorepo where that
    // trade-off goes the other way, so it is opted out locally rather than
    // relaxed for everyone else.
    "verbatimModuleSyntax": false
  },
  // The HUD payload types come from `@tokenslens/core`, resolved through its built
  // `dist/index.d.ts` rather than mapped to its source. That is deliberate:
  // this package is a *consumer* of core, so typechecking against the
  // published declarations catches a type that was never exported from
  // index.ts, which a source mapping would silently paper over. The cost is
  // that core must be built first — which `npm run build` at the root already
  // guarantees, since workspace order puts core ahead of this package.
  "include": ["src/**/*"],
  "exclude": ["dist", "node_modules"]
}
