{
  "name": "tokenlens",
  "version": "0.1.0",
  "private": true,
  "description": "Measured GitHub Copilot credit ledger, waste attribution, and policy compiler for VS Code.",
  "type": "module",
  "bin": {
    "tokenlens": "./dist/cli/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "scripts": {
    "build": "npm run clean && tsup && node scripts/copy-static.mjs",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "better-sqlite3": "^13.0.2",
    "commander": "^12.1.0",
    "fastify": "^5.11.0",
    "open": "^11.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^20.19.43"
  }
}
