{
  "name": "tokenlens-workspace",
  "version": "0.1.0",
  "private": true,
  "description": "TokenLens monorepo — the tokenlens CLI/core package and its companion VS Code extension.",
  "type": "module",
  "homepage": "https://github.com/Ashutosh-Panda2004/TokensLens#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ashutosh-Panda2004/TokensLens.git"
  },
  "bugs": {
    "url": "https://github.com/Ashutosh-Panda2004/TokensLens/issues"
  },
  "workspaces": [
    "packages/*"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20",
    "npm": ">=10"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev -w @tokenslens/core",
    "test": "npm run test --workspaces --if-present && npm run test:performance -w @tokenslens/core",
    "test:watch": "npm run test:watch -w @tokenslens/core",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify:release": "node scripts/verify-release.mjs",
    "audit:production": "npm audit --omit=dev --audit-level=moderate",
    "cli:link": "npm run build -w @tokenslens/core && npm link -w @tokenslens/core",
    "cli:unlink": "npm rm -g @tokenslens/core",
    "clean": "npm run clean --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "^1.6.0",
    "eslint": "^9.9.0",
    "prettier": "^3.3.0",
    "tsup": "^8.1.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.0.0",
    "vitest": "^1.6.0"
  }
}
